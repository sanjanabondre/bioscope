# Copy this file to .env and fill in your own values.

# The wallet address that should receive testnet USDC payments.
# Any Base Sepolia address you control -- e.g. your MetaMask address.
PAY_TO_ADDRESS=0x410C1747c40aB26A4B54a89FD4214C160404Eb7A

# CAIP-2 network id. Base Sepolia is the public testnet used throughout
# this project so anyone can try it for free with faucet funds.
X402_NETWORK=eip155:84532

# x402 facilitator. The public one below needs no signup and works with
# Base Sepolia out of the box -- fine for this project. Point this at a
# CDP facilitator (with an API key) if you move to mainnet.
X402_FACILITATOR_URL=https://x402.org/facilitator

# The browser-visible origin this server runs behind. SIWX signatures are
# bound to this value, so it must match what a wallet actually sees in
# its address bar (protocol + host + port).
PUBLIC_ORIGIN=http://localhost:3000

# Price to unlock one reel. Any tiny USD amount x402 supports.
PRICE_USD=$0.01

PORT=3000
